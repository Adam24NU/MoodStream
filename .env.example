# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.

# Flask secret key — used for signing session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# Spotify Web API credentials.
# Create an app at https://developer.spotify.com/dashboard
# Client Credentials flow is used — no redirect URI configuration needed.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Spotify OAuth redirect URI — must match exactly what is set in your Spotify Developer Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Set to "true" to enable Flask debug mode locally. Never use in production.
FLASK_DEBUG=false

# Optional: override the default SQLite URI (e.g. for PostgreSQL in production).
# DATABASE_URL=postgresql://user:password@localhost/moodify
